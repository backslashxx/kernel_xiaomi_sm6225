#
# KernelSU
#
CONFIG_KSU=y
CONFIG_KSU_TAMPER_SYSCALL_TABLE=n
CONFIG_KSU_FEATURE_SULOG=y
CONFIG_KSU_FEATURE_ADBROOT=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED=y
CONFIG_KSU_LSM_SECURITY_HOOKS=y

CONFIG_KPROBES=y
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y

CONFIG_COMPAT_VDSO=y
CONFIG_THUMB2_COMPAT_VDSO=y
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG CFI_CLANG=y
# CONFIG SHADOW_CALL_STACK is not set
CONFIG_THINLTO=y
